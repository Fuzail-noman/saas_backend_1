NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nimbus

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional: comma separated allowed origins. Empty = allow any origin.
CORS_ORIGINS=
